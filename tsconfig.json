{
  "compilerOptions": {
    "target": "es2023",
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["bun"],
    "paths": {
      "@anthropic-ai/sdk": ["./app/node_modules/@anthropic-ai/sdk"],
      "@google/genai": ["./app/node_modules/@google/genai"]
    }
  },
  "include": ["tools/**/*.ts", "test/**/*.ts"]
}
