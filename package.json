{
  "name": "spiderv-web-control",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cd app && bun run dev",
    "build": "cd app && bun run build",
    "build:exe": "bun run build && bun tools/build-exe.ts",
    "check": "cd app && bun run check",
    "test": "bun test",
    "typecheck": "app/node_modules/.bin/tsc -p tsconfig.json",
    "cli": "bun tools/spiderv-cli.ts",
    "build:lib": "cd packages/spiderv && bun build.ts"
  },
  "devDependencies": {
    "@julusian/midi": "^3.8.1",
    "@types/bun": "^1.4.3",
    "spiderv-protocol": "workspace:*"
  },
  "workspaces": [
    "packages/*",
    "app"
  ]
}
